{
  "name": "inthepocket-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=product",
    "test:sim": "playwright test --project=simulation",
    "check:isolation": "npm run build && node scripts/check-isolation.mjs",
    "check:offline": "npm run build && node scripts/check-precache.mjs",
    "test:e2e:offline": "npm run build && node scripts/test-offline.mjs",
    "generate:icons": "pwa-assets-generator"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@preact/signals": "^2.9.4",
    "preact": "^10.29.7",
    "tone": "^15.1.22",
    "webmidi": "^3.1.16",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@preact/preset-vite": "^2.10.5",
    "@types/audioworklet": "^0.0.100",
    "@types/node": "^24.13.2",
    "@types/webmidi": "^2.1.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-build": "^7.4.1"
  }
}
