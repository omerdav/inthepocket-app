{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.sw.tsbuildinfo",
    "target": "es2023",
    "module": "esnext",
    /**
     * WebWorker instead of DOM. A service worker has no `document` and its
     * `self` is a ServiceWorkerGlobalScope; the two libs cannot be combined,
     * which is why src/sw.ts is excluded from tsconfig.app.json.
     */
    "lib": ["ES2023", "WebWorker"],
    "types": [],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/sw.ts"]
}
